# ─────────────────────────────────────────────────────────────
# DEVFORGE AI — environment variables
# Copy this file to .env.local for local dev (never commit the real file).
# On Vercel, set these under Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Client-exposed (safe to ship to the browser) ──
# Supabase anon key is public by design — access is enforced by RLS, not secrecy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server-only secrets (Vercel serverless functions, NEVER prefixed VITE_) ──
GEMINI_API_KEY=
OPENROUTER_API_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI safety limits (server-enforced, see api/lib/limits.ts) ──
MAX_AI_REQUESTS_PER_MINUTE=10
MAX_AI_REQUESTS_PER_DAY=200
MAX_INPUT_CHARS=12000
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_TOKENS=8000
MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE=200000
MAX_GENERATED_FILES=20
MAX_MULTI_FILE_CHANGES=8
MAX_AGENT_STEPS=12
MAX_PROJECT_SIZE=5000000
MAX_CONCURRENT_AI_TASKS=2
